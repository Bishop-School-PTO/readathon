// Cloudflare Worker for the embedded donation form and the donation-page cache.
// See README "Embedded donation form" and "Faster donation pages".
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "readathon-checkout",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // The "customer chooses what to pay" price behind the donation Payment Link.
    // Sandbox price; replace with the live price ID when going live.
    "STRIPE_PRICE_ID": "price_1UVse8K9lkVDlZj3IHBo7EM9",
    "SITE_URL": "https://readathon.bishopschoolpto.com",
    "ALLOWED_ORIGINS": "https://readathon.bishopschoolpto.com",
    "TURNSTILE_HOSTNAMES": "readathon.bishopschoolpto.com",
    // Same URL as apiUrl in public/config.js. The donation-page cache reads from it.
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbyTY8HNY1eMpmVgUvF_mlPWiEajmafQjBeOSEwoG-B0hAzCZblGSW13awHJVeNQkCFd8A/exec"
  },
  // Donation-page cache (src/donation.js). The Worker creates its table on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "readathon-donation-cache",
      "database_id": "427d7dc4-30da-4154-8e7f-3d626c670f04"
    }
  ]
  // Secrets (not in this file): npx wrangler secret put STRIPE_SECRET_KEY
  //                             npx wrangler secret put TURNSTILE_SECRET_KEY
}
